// Step 9: the model file, filled in. The comments say where each value comes
// from; the processor drops them before anira reads the file.
{
  "models": [
    { "engine": "onnxruntime", "path": "../../common/assets/models/rave/model_forward.onnx" }
  ],
  "inputs": [
    {
      "name": "audio",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 1], ["time", 2048]]   // TODO1: the model's block, 2048 samples per inference (step 1)
    },
    {
      "name": "state_in",
      "dtype": "float32",
      "role": "state",
      "axes": [["batch", 1], ["any", 63488]],   // TODO2: the state of step 2, 63,488 floats
      "state_source": "state_out"               // TODO2: C, the state output; anira feeds it back, no copy
    }
  ],
  "outputs": [
    {
      "name": "audio_out",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 1], ["time", 2048]],   // TODO1: as the input
      "latency": 2224                                          // TODO1: the model's own delay, 2224 samples (step 7)
    },
    {
      "name": "state_out",
      "dtype": "float32",
      "role": "state",
      "axes": [["batch", 1], ["any", 63488]]   // TODO2: as state_in
    }
  ]
}
