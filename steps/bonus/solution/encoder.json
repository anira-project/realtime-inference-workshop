// Bonus: the encoder, filled in. The comments say where each value comes from.
// The comments are hints; the processor drops them before anira reads the file.
{
  "models": [
    { "engine": "onnxruntime", "path": "../../common/assets/models/rave/model_encoder.onnx" }
  ],
  "inputs": [
    {
      "name": "audio_in",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 1], ["time", 2048]]   // TODO1: one model block, 2048 samples, as in step 9
    },
    {
      "name": "state_in",
      "dtype": "float32",
      "role": "state",
      "axes": [["batch", 1], ["any", 34304]],
      "state_source": "state_out"
    }
  ],
  "outputs": [
    {
      "name": "latents",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 8], ["time", 1]]   // TODO1: eight latents, one frame per inference
    },
    {
      "name": "state_out",
      "dtype": "float32",
      "role": "state",
      "axes": [["batch", 1], ["any", 34304]]
    }
  ]
}
