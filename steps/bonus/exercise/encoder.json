// Bonus: the encoder. Replace every ? with its value, a number as it is.
// The comments are hints; the processor drops them before anira reads the file.
{
  "models": [
    { "engine": "onnxruntime", "path": "../../common/assets/models/rave/model_encoder.onnx" }
  ],
  "inputs": [
    {
      "name": "audio_in",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 1], ["time", ?]]   // TODO1: audio samples per inference, as in step 9
    },
    {
      "name": "state_in",
      "dtype": "float32",
      "role": "state",
      "axes": [["batch", 1], ["any", 34304]],
      "state_source": "state_out"
    }
  ],
  "outputs": [
    {
      "name": "latents",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", ?], ["time", ?]]   // TODO1: how many latents, and frames per inference
    },
    {
      "name": "state_out",
      "dtype": "float32",
      "role": "state",
      "axes": [["batch", 1], ["any", 34304]]
    }
  ]
}
