// Bonus: the decoder. Replace every ? with its value, a number as it is.
// The comments are hints; the processor drops them before anira reads the file.
{
  "models": [
    { "engine": "onnxruntime", "path": "../../common/assets/models/rave/model_decoder.onnx" }
  ],
  "anchor": "audio_out",
  "inputs": [
    {
      "name": "latents",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", ?], ["time", ?]]   // TODO1: what the encoder gives
    },
    {
      "name": "state_in",
      "dtype": "float32",
      "role": "state",
      "axes": [["batch", 1], ["any", 29184]],
      "state_source": "state_out"
    }
  ],
  "outputs": [
    {
      "name": "audio_out",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 1], ["time", ?]],   // TODO1: audio samples per inference
      "latency": 2224
    },
    {
      "name": "state_out",
      "dtype": "float32",
      "role": "state",
      "axes": [["batch", 1], ["any", 29184]]
    }
  ]
